APP_NAME=PilaPH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file

# Port for `composer run dev` / `php artisan serve` (8000 is often taken).
SERVER_PORT=8100

BCRYPT_ROUNDS=12

# Production: LOG_CHANNEL=stderr so logs show in Railway's log viewer.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: the Postgres container from docker-compose.yml (`docker compose up -d postgres`).
# Production: Supabase Postgres via the Session pooler (Connect -> Session pooler),
# DB_USERNAME looks like "postgres.<project-ref>", and DB_SSLMODE=require.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pilaph
DB_USERNAME=pilaph
DB_PASSWORD=pilaph
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Database cache supports the atomic locks used by "Call next".
CACHE_STORE=database

# Account emails (verification, password reset). `log` writes them to the log.
# Production: MAIL_MAILER=resend with RESEND_API_KEY (resend.com -> API Keys) and
# a MAIL_FROM_ADDRESS on a domain verified in Resend. Any SMTP service also works
# (MAIL_MAILER=smtp and the MAIL_HOST/PORT/USERNAME/PASSWORD below).
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# "Continue with Google" for owners (button hidden when empty). Google Cloud
# Console -> APIs & Services -> Credentials -> OAuth client (Web application).
# Authorized redirect URI: <APP_URL>/auth/google/callback for each domain,
# e.g. http://localhost:8100/auth/google/callback. No JavaScript origins needed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Realtime Broadcast (live updates; pages fall back to polling without it).
# SUPABASE_SERVICE_ROLE_KEY: a secret key (sb_secret_...) or the legacy service_role JWT.
# Server only; browsers get the publishable key below.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A public Storage bucket for shop photos (production: Railway's disk is wiped
# on every deploy). Empty keeps photos on the local disk (php artisan storage:link).
SUPABASE_STORAGE_BUCKET=

# Build-time variables for the frontend (Docker build arguments in production).
VITE_APP_NAME="${APP_NAME}"
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key.
VITE_SUPABASE_ANON_KEY=

# SMS: `log` writes texts to the log (and sms_logs); `semaphore` sends real SMS.
# SEMAPHORE_API_KEY: semaphore.co -> Account -> API. Server only.
# SEMAPHORE_SENDER_NAME: only after Semaphore approves it; empty sends as
# Semaphore's default sender (an unapproved name makes every text fail).
SMS_DRIVER=log
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Owner web push. Generate keys with: npx web-push generate-vapid-keys
# VAPID_SUBJECT: "mailto:you@example.com" or an https:// URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# "Try the demo": visitors use a sample shop that resets every hour.
DEMO_ENABLED=false

# Paying for plans by QR Ph through HitPay (hitpayapp.com, Developers): the API
# key, and the salt of the webhook https://your-domain/webhooks/hitpay. Server
# only. Empty: Plan & billing shows the manual GCash/Maya steps below instead.
HITPAY_API_KEY=
HITPAY_SALT=
# true: HitPay's sandbox (test payments only). false with the live account.
HITPAY_SANDBOX=true
# How owners pay, as HitPay names them (empty: QR Ph). HitPay's sandbox has
# no QR Ph (and must be a Singapore account): use card there.
HITPAY_PAYMENT_METHODS=

# Plan & billing: where owners pay for a plan (config/plans.php). Leave empty
# what you don't use; all empty shows "Paid plans open soon". After a payment:
# php artisan plan:set {shop link name or owner email} basic --months=1
PAYMENT_GCASH_NUMBER=
PAYMENT_MAYA_NUMBER=
PAYMENT_ACCOUNT_NAME=
# Where owners send the receipt screenshot: an email address or a link.
PAYMENT_CONTACT=

# "Support the developer" at the bottom of owner pages: your GCash or Maya
# "receive money" QR image, as a path under public/ (e.g.
# /images/support-qr.png) or an https:// address. Empty: hidden.
SUPPORT_QR_URL=
