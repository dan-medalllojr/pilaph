APP_NAME=PilaPH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file

# Port for `composer run dev` / `php artisan serve` (8000 is often taken).
SERVER_PORT=8100

BCRYPT_ROUNDS=12

# Production: LOG_CHANNEL=stderr so logs show in Railway's log viewer.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: the Postgres container from docker-compose.yml (`docker compose up -d postgres`).
# Production: Supabase Postgres via the Session pooler (Connect -> Session pooler),
# DB_USERNAME looks like "postgres.<project-ref>", and DB_SSLMODE=require.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pilaph
DB_USERNAME=pilaph
DB_PASSWORD=pilaph
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Database cache supports the atomic locks used by "Call next".
CACHE_STORE=database

# Account emails (verification, password reset). Production needs a real SMTP
# provider such as Resend, Brevo or Amazon SES.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Supabase Realtime Broadcast. The service-role key stays on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Build-time variables for the frontend (Docker build arguments in production).
VITE_APP_NAME="${APP_NAME}"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SMS: `log` writes messages to the log; `semaphore` sends real SMS.
SMS_DRIVER=log
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=PILAPH

# Owner web push. Generate keys with: npx web-push generate-vapid-keys
# VAPID_SUBJECT: "mailto:you@example.com" or an https:// URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
