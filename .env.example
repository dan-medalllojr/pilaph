# PORT: port the server listens on (default 3000). Change it if 3000 is already in use.
PORT=3000

# APP_URL: public address of the app, used for ticket links in SMS.
# Leave empty locally; set it when you deploy, e.g. "https://pilaph.example.com".
APP_URL=""

# Database: Supabase Postgres via the Session pooler (Supabase -> Connect -> Direct -> Session pooler).
# SQL_USER looks like "postgres.<project-ref>". SQL_ADMIN_* are only used by drizzle-kit.
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Supabase (required for owner sign-in via Supabase Auth; also enables Realtime Broadcast)
# SUPABASE_SERVICE_ROLE_KEY: legacy service_role JWT (server only, never a VITE_ var)
# VITE_SUPABASE_ANON_KEY: publishable key (sb_publishable_...) or legacy anon key
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SMS Provider Configuration ('log' for development/demo or 'semaphore' for live PH SMS)
SMS_DRIVER="log"
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME="PILAPH"

# Owner push alerts (Web Push). Generate keys with: npx web-push generate-vapid-keys
# VAPID_SUBJECT: contact push services can reach you at, "mailto:you@example.com" or an https:// URL.
# Alerts are off until all three are set.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
